{
  "manifest_version": 3,
  "name": "programmers-tracker sensor",
  "version": "0.2.0",
  "description": "Tells your local programmers-tracker which problem you are looking at, reports the focused time and whether the questions tab was opened, and hands it your Programmers session cookie when the server says it has none or a dead one.",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.programmers.co.kr/*"
  ],
  "action": {
    "default_title": "programmers-tracker sensor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://school.programmers.co.kr/learn/courses/*/lessons/*"
      ],
      "js": [
        "sensor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
