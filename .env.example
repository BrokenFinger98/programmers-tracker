# Copy to `.env` (gitignored) and fill in. `docker compose up` reads it automatically.
# Walkthrough: docs/bootstrap.md

# --- required ----------------------------------------------------------------

# Absolute host path to your record repository — a git repository you own, separate from
# this one. Records are yours and live outside the container; see bootstrap.md step 3.
#
# Left EMPTY on purpose. `compose.yaml` guards this with `${...:?}`, which rejects an empty
# value but happily accepts a placeholder — so a sample path here would let an unedited
# `.env` start cleanly and record into a directory named after the placeholder.
#
# `~` is NOT expanded here. Write the path out in full, e.g. /Users/you/ps-records
TRACKER_RECORD_REPO=

# git will not commit without an identity, and the container has none of its own.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# --- optional ----------------------------------------------------------------

# Host loopback port. The container listens on the same number.
# TRACKER_PORT=1619

# Where the session cookie is read from, on the host. Mounted read-only.
# TRACKER_SESSION_FILE=./.ps/session

# Where the generated /watch token is kept, on the host. Raw frames, timers and the backup
# marker are NOT here — they live in <TRACKER_RECORD_REPO>/.ps/, beside the records they
# describe, and need no setting of their own. This one stays separate because a token is a
# credential and the record repository is pushed.
# TRACKER_STATE_DIR=./.ps

# Linux only: match the owner of TRACKER_RECORD_REPO so the container can write it.
# `id -u` and `id -g`. Docker Desktop on macOS and Windows remaps ownership — skip these.
# TRACKER_UID=1000
# TRACKER_GID=1000

# Lets the first boot create a PRIVATE GitHub repository for your records, wire it as
# origin, store the push credential owner-only inside the records' gitignored .ps/, and
# push. Blank does nothing; an existing origin is never rewired.
#
# Permissions — classic token: the single `repo` scope. Fine-grained: access to All
# repositories, with Administration (read/write, for creation) + Contents (read/write,
# for pushes); if creation is refused, the log says so — use classic.
# You may delete this line after the first boot; the stored credential carries pushes.
# Tightening later: put a Contents-only token scoped to just this repository in here and
# restart — the stored credential is refreshed on every boot that has a token.
# GITHUB_TOKEN=

# The clock your records are stamped with, and the one the vault's attempt history renders.
# A container knows nothing about where you are: leave this out and everything is UTC, which
# is a correct instant and the wrong wall clock. The server prints the zone it is using on
# every start, so you can tell at a glance.
TZ=UTC

# The daily push (design §4.6). The hour defaults to 23:00; the zone follows TZ above unless
# you set it, so the two cannot disagree about what day it is.
# TRACKER_BACKUP_AT=23:00
# TRACKER_BACKUP_ZONE=
