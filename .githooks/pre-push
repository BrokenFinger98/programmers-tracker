#!/usr/bin/env bash
# wiki push gate — blocks the push when its range contains no docs/llm-wiki/ change.
# Purpose: force per-branch distillation (/wiki-ingest). Prevents decisions and know-how
# from being published unrecorded.
# Principle: fail-open — any git error or unexpected input passes. This gate prevents
# *unconscious omission*; it is not a bypass-prevention device. Intentional exceptions
# are recorded via the commit trailer `Wiki-Skip: <reason>`.
# Rationale: docs/superpowers/specs/2026-08-04-record-keeping-design.md §3.3
set -u

WIKI_DIR="docs/llm-wiki/"
Z40="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  # Gate branches only — tags and notes pass.
  # Must key off remote_ref: local_ref is the literal refspec source, so it
  # arrives as "HEAD" on `git push origin HEAD` (measured — E2E S1).
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  # Branch-deletion push — no commits to inspect
  [ "$local_sha" = "$Z40" ] && continue

  if [ "$remote_sha" = "$Z40" ]; then
    # New branch: inspect only commits absent from every remote
    range=("$local_sha" --not --remotes)
  else
    range=("$remote_sha..$local_sha")
  fi

  # Number of new commits being pushed — 0 means nothing new is published (only a branch pointer to existing commits)
  total=$(git rev-list --count "${range[@]}" -- 2>/dev/null) || { echo "wiki-gate: skip (rev-list failed — fail-open)" >&2; continue; }
  [ "$total" -eq 0 ] && continue

  # Pass if the range contains a wiki change
  wiki=$(git rev-list --count "${range[@]}" -- "$WIKI_DIR" 2>/dev/null) || { echo "wiki-gate: skip (rev-list failed — fail-open)" >&2; continue; }
  if [ "$wiki" -gt 0 ]; then
    echo "wiki-gate: pass — $WIKI_DIR changes included. Consider /wiki-lint before the PR." >&2
    continue
  fi

  # Escape hatch: a Wiki-Skip trailer on a commit in the range (leaves the reason as an audit trail)
  reason=$(git log "${range[@]}" --format='%(trailers:key=Wiki-Skip,valueonly)' 2>/dev/null | grep -m1 . || true)
  if [ -n "$reason" ]; then
    echo "wiki-gate: skipped by trailer — Wiki-Skip: $reason" >&2
    continue
  fi

  echo "" >&2
  echo "✖ wiki-gate: no $WIKI_DIR change in the pushed range ($total commits)." >&2
  echo "  Record this branch's decisions and know-how first: /wiki-ingest" >&2
  echo "  If there is truly nothing to record, leave an auditable reason:" >&2
  echo "    git commit --amend --no-edit --trailer 'Wiki-Skip: <reason>'" >&2
  exit 1
done

exit 0
