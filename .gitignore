# Credentials — no exceptions
.ps/*
!.ps/.gitkeep
*.local.yml
application-local.yml
.env

# Personal Docker overrides. `docker compose` reads this automatically, which makes it the
# right place for a credential mount whose path is one machine's — and the wrong thing to
# commit, since compose.yaml must stay free of anyone's private paths.
compose.override.yaml
compose.override.yml

# Personal work state (progress IS committed)
.harness/state/goal.md

# Session transcripts dropped here by the PreCompact/SessionEnd hooks, waiting for
# /wiki-ingest. A transcript is the whole conversation — every file read, every command run —
# so one `git add -A` would publish it. This rule is what lets the hook write here at all: it
# checks `git check-ignore` and falls back to the global inbox when the path is committable.
docs/llm-wiki/raw/inbox/

# Build
build/
.gradle/
out/
*.class

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
