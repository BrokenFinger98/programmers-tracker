{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(./scripts/check.sh)",
      "Bash(./scripts/test.sh)",
      "Bash(./scripts/build.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-state.sh"
          }
        ]
      }
    ]
  }
}
