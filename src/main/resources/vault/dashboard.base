formulas:
  directory: |
    file.folder
properties:
  note.title:
    displayName: Problem
  note.tag:
    displayName: Tag
  note.level:
    displayName: Level
  note.part:
    displayName: Part
  note.language:
    displayName: Language
  note.verdict:
    displayName: Verdict
  note.attempts:
    displayName: Submits
  note.runCount:
    displayName: Runs
  note.acceptanceRate:
    displayName: Accepted %
  note.lastSubmit:
    displayName: Last submit
  note.firstSeen:
    displayName: First seen
  note.kind:
    displayName: Kind
  note.status:
    displayName: Status
  note.catalogTotal:
    displayName: In catalog
  note.attempted:
    displayName: Met
  note.solved:
    displayName: Passed
  formula.directory:
    displayName: Folder
  file.name:
    displayName: Open
views:
  - type: table
    name: Recent
    filters:
      and:
        - note.lessonId != null
    order:
      - title
      - level
      - kind
      - language
      - verdict
      - attempts
      - runCount
      - lastSubmit
      - file.name
    sort:
      - property: lastSubmit
        direction: DESC
  - type: table
    name: Not passed yet
    filters:
      and:
        - note.lessonId != null
        - note.verdict != "PASS"
    order:
      - title
      - level
      - kind
      - language
      - verdict
      - attempts
      - acceptanceRate
      - lastSubmit
      - file.name
    sort:
      - property: lastSubmit
        direction: DESC
  - type: table
    name: By attempts
    filters:
      and:
        - note.lessonId != null
    order:
      - title
      - level
      - attempts
      - runCount
      - verdict
      - acceptanceRate
      - file.name
    sort:
      - property: attempts
        direction: DESC
  - type: table
    name: By part
    filters:
      and:
        - note.lessonId != null
    groupBy:
      property: part
      direction: ASC
    order:
      - title
      - level
      - language
      - verdict
      - attempts
      - file.name
    sort:
      - property: level
        direction: ASC
  - type: table
    name: By kind
    filters:
      and:
        - note.lessonId != null
    groupBy:
      property: kind
      direction: ASC
    order:
      - title
      - level
      - language
      - verdict
      - attempts
      - lastSubmit
      - file.name
    sort:
      - property: lastSubmit
        direction: DESC
  - type: table
    name: By language
    filters:
      and:
        - note.lessonId != null
    groupBy:
      property: language
      direction: ASC
    order:
      - title
      - level
      - verdict
      - attempts
      - lastSubmit
      - file.name
    sort:
      - property: lastSubmit
        direction: DESC
  - type: table
    name: Tags
    filters:
      and:
        - note.tag != null
    groupBy:
      property: status
      direction: ASC
    order:
      - tag
      - catalogTotal
      - attempted
      - solved
      - file.name
    sort:
      - property: catalogTotal
        direction: DESC
